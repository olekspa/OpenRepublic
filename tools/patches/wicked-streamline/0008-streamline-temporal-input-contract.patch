From 2a767dd685ce5b841487c958bcac360c6582257c Mon Sep 17 00:00:00 2001
From: OpenRepublic contributors <dev@openrepublic.invalid>
Date: Fri, 23 Oct 2026 03:33:00 -0400
Subject: [PATCH] Fix Streamline temporal input contract

---
 WickedEngine/wiRenderPath3D.cpp | 15 ++++++++-------
 1 file changed, 8 insertions(+), 7 deletions(-)

diff --git a/WickedEngine/wiRenderPath3D.cpp b/WickedEngine/wiRenderPath3D.cpp
index 1410a23d..cf9cded7 100644
--- a/WickedEngine/wiRenderPath3D.cpp
+++ b/WickedEngine/wiRenderPath3D.cpp
@@ -68,7 +68,8 @@ namespace wi
 		sl::DLSSOptimalSettings optimal{};
 		if (getOptimal(options, optimal) != sl::Result::eOk || optimal.optimalRenderWidth != inputColor.desc.width || optimal.optimalRenderHeight != inputColor.desc.height)
 			return false; // resource recreation for a changed optimal size must happen before dispatch
-		if (setOptions(viewport, options) != sl::Result::eOk) return false;
+		options.sharpness = optimal.optimalSharpness;
+`t`tif (setOptions(viewport, options) != sl::Result::eOk) return false;
 
 		sl::FrameToken* token = nullptr;
 		if (getToken(token, nullptr) != sl::Result::eOk || token == nullptr) return false;
@@ -81,11 +82,11 @@ namespace wi
 					(&dst[row].x)[col] = data[row * 4 + col];
 		};
 		XMFLOAT4X4 projection = camera.Projection;
-		projection._41 -= camera.jitter.x;
-		projection._42 -= camera.jitter.y;
+		projection._31 -= camera.jitter.x;
+		projection._32 -= camera.jitter.y;
 		XMFLOAT4X4 previousProjection = previousCamera.Projection;
-		previousProjection._41 -= previousCamera.jitter.x;
-		previousProjection._42 -= previousCamera.jitter.y;
+		previousProjection._31 -= previousCamera.jitter.x;
+		previousProjection._32 -= previousCamera.jitter.y;
 		const XMMATRIX viewToClip = XMLoadFloat4x4(&projection);
 		const XMMATRIX clipToView = XMMatrixInverse(nullptr, viewToClip);
 		const XMMATRIX currentViewProjection = camera.GetView() * viewToClip;
@@ -102,7 +103,7 @@ namespace wi
 		toSLMatrix(clipToPreviousStore, constants.clipToPrevClip);
 		toSLMatrix(previousToClipStore, constants.prevClipToClip);
 		constants.jitterOffset = { camera.jitter.x * inputColor.desc.width * 0.5f, camera.jitter.y * inputColor.desc.height * -0.5f };
-		constants.mvecScale = { 1.0f, 1.0f };
+		constants.mvecScale = { 1.0f, -1.0f };
 		constants.cameraPos = { camera.Eye.x, camera.Eye.y, camera.Eye.z };
 		constants.cameraUp = { camera.Up.x, camera.Up.y, camera.Up.z };
 		const XMVECTOR rightVector = camera.GetRight();
@@ -119,7 +120,7 @@ namespace wi
 		constants.depthInverted = sl::Boolean::eTrue;
 		constants.cameraMotionIncluded = sl::Boolean::eTrue;
 		constants.motionVectors3D = sl::Boolean::eFalse;
-		constants.motionVectorsJittered = sl::Boolean::eTrue;
+		constants.motionVectorsJittered = sl::Boolean::eFalse;
 		constants.reset = reset ? sl::Boolean::eTrue : sl::Boolean::eFalse;
 		if (setConstants(constants, *token, viewport) != sl::Result::eOk) return false;
 
-- 
