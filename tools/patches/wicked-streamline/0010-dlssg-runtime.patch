+	static sl::Result SetStreamlineMarker(sl::PCLMarker marker)
+	{
+		if (!streamline_initialized || streamline_module == nullptr || streamline_frame_token == nullptr)
+			return sl::Result::eErrorFeatureNotSupported;
+		{
+			std::scoped_lock lock(streamline_pcl_marker_mutex);
+			if (!streamline_pcl_marker_lookup_complete)
+			{
+				streamline_pcl_marker_lookup_complete = true;
+				auto getFeatureFunction = reinterpret_cast<PFun_slGetFeatureFunction*>(GetProcAddress(streamline_module, "slGetFeatureFunction"));
+				void* function = nullptr;
+				const sl::Result lookupResult = getFeatureFunction
+					? getFeatureFunction(sl::kFeaturePCL, "slPCLSetMarker", function)
+					: sl::Result::eErrorFeatureNotSupported;
+				streamline_set_pcl_marker = lookupResult == sl::Result::eOk ? reinterpret_cast<PFun_slPCLSetMarker*>(function) : nullptr;
+				std::ostringstream lookupLog;
+				lookupLog << "Streamline slGetFeatureFunction(kFeaturePCL, slPCLSetMarker) result="
+					<< static_cast<int>(lookupResult) << " function=" << (streamline_set_pcl_marker != nullptr) << "\n";
+				WriteStreamlineDiagnostic(lookupLog.str());
+			}
+		}
+		const uint32_t frameIndex = static_cast<uint32_t>(*streamline_frame_token);
+		const sl::Result result = streamline_set_pcl_marker
+			? streamline_set_pcl_marker(marker, *streamline_frame_token)
+			: sl::Result::eErrorFeatureNotSupported;
+		static uint64_t markerCount = 0;
+		++markerCount;
+		if (markerCount <= 8 || markerCount % 120 == 0)
+		{
+			std::ostringstream log;
+			log << "Streamline PCL marker=" << static_cast<uint32_t>(marker) << " frameIndex=" << frameIndex
+				<< " result=" << static_cast<int>(result) << " count=" << markerCount << "\n";
+			WriteStreamlineDiagnostic(log.str());
+		}
+		return result;
+	}
+	void* StreamlineBeginFrame()
+	{
+		if (!streamline_initialized || streamline_module == nullptr)
+			return nullptr;
+		auto getToken = reinterpret_cast<PFun_slGetNewFrameToken*>(GetProcAddress(streamline_module, "slGetNewFrameToken"));
+		if (!getToken)
+			return nullptr;
+		// GetFrameCount is the engine's current zero-based submit index; SubmitCommandLists increments it
+		// only after this frame's rendering and Present have been submitted.
+		auto* graphicsDevice = GetDevice();
+		if (graphicsDevice == nullptr)
+			return nullptr;
+		const uint32_t appFrameIndex = static_cast<uint32_t>(graphicsDevice->GetFrameCount());
+		{
+			std::scoped_lock lock(streamline_frame_mutex);
+			streamline_frame_token = nullptr;
+			if (getToken(streamline_frame_token, &appFrameIndex) != sl::Result::eOk || streamline_frame_token == nullptr)
+				return nullptr;
+		}
+		static uint64_t frameCount = 0;
+		const uint32_t tokenFrameIndex = static_cast<uint32_t>(*streamline_frame_token);
+		++frameCount;
+		if (frameCount <= 8 || frameCount % 120 == 0)
+		{
+			std::ostringstream log;
+			log << "Streamline BeginFrame requestedAppFrameIndex=" << appFrameIndex
+				<< " tokenFrameIndex=" << tokenFrameIndex << " count=" << frameCount << "\n";
+			WriteStreamlineDiagnostic(log.str());
+		}
+		if (streamline_fg_enabled)
+			SetStreamlineMarker(sl::PCLMarker::eSimulationStart);
+		if (streamline_fg_enabled)
+		{
+			auto setReflex = reinterpret_cast<PFun_slReflexSetOptions*>(GetProcAddress(streamline_module, "slReflexSetOptions"));
+			if (setReflex)
+			{
+				sl::ReflexOptions reflexOptions{};
+				reflexOptions.mode = sl::ReflexMode::eLowLatency;
+				setReflex(reflexOptions);
+			}
+			auto reflexSleep = reinterpret_cast<PFun_slReflexSleep*>(GetProcAddress(streamline_module, "slReflexSleep"));
+			if (reflexSleep)
+				reflexSleep(*streamline_frame_token);
+		}
+		return streamline_frame_token;
+	}
+	void* StreamlineGetCurrentFrameToken()
+	{
+		std::scoped_lock lock(streamline_frame_mutex);
+		return streamline_frame_token;
+	}
+	void StreamlineSetPCLMarker(sl::PCLMarker marker) { SetStreamlineMarker(marker); }
+	void StreamlineSetRenderSubmitStart() { SetStreamlineMarker(sl::PCLMarker::eRenderSubmitStart); }
+	void StreamlineSetRenderSubmitEnd() { SetStreamlineMarker(sl::PCLMarker::eRenderSubmitEnd); }
+	void StreamlineSetPresentStart() { SetStreamlineMarker(sl::PCLMarker::ePresentStart); }
+	void StreamlineSetPresentEnd() { SetStreamlineMarker(sl::PCLMarker::ePresentEnd); }
+	bool StreamlineIsFrameGenerationEnabled() { return streamline_fg_enabled; }
+	uint32_t StreamlineGetGeneratedFrameCount() { return streamline_fg_generated_frames; }
+#endif
