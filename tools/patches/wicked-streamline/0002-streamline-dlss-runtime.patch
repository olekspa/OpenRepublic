+#endif
 
 #ifdef PLATFORM_WINDOWS_DESKTOP
 		std::ignore = UnregisterWait(deviceRemovedWaitHandle);
@@ -7871,6 +7942,10 @@ std::mutex queue_locker;
 	{
 		return to_internal(texture)->resource.Get();
 	}
