@@ -2258,6 +2315,9 @@ std::mutex queue_locker;
 		}
 
 		CreateDXGIFactory2 = (PFN_CREATE_DXGI_FACTORY_2)wiGetProcAddress(dxgi, "CreateDXGIFactory2");
+#ifdef OPENREPUBLIC_STREAMLINE
+		if (streamline_initialized) { auto fn = reinterpret_cast<PFN_CREATE_DXGI_FACTORY_2>(GetProcAddress(streamline_module, "CreateDXGIFactory2")); if (fn) CreateDXGIFactory2 = fn; }
+#endif
 		assert(CreateDXGIFactory2 != nullptr);
 		if (CreateDXGIFactory2 == nullptr)
 		{
@@ -2276,6 +2336,9 @@ std::mutex queue_locker;
 #endif
 
 		D3D12CreateDevice = (PFN_D3D12_CREATE_DEVICE)wiGetProcAddress(dx12, "D3D12CreateDevice");
+#ifdef OPENREPUBLIC_STREAMLINE
+		if (streamline_initialized) { auto fn = reinterpret_cast<PFN_D3D12_CREATE_DEVICE>(GetProcAddress(streamline_module, "D3D12CreateDevice")); if (fn) D3D12CreateDevice = fn; }
+#endif
 		assert(D3D12CreateDevice != nullptr);
 		if (D3D12CreateDevice == nullptr)
 		{
@@ -2472,6 +2535,9 @@ std::mutex queue_locker;
 			wilog_messagebox("D3D12: Device couldn't be created!");
 			wi::platform::Exit();
 		}
+#ifdef OPENREPUBLIC_STREAMLINE
+		if (streamline_initialized && streamline_set_device(device.Get()) != sl::Result::eOk) { wi::helper::DebugOut("Streamline slSetD3DDevice failed\n"); streamline_shutdown(); streamline_initialized = false; }
+#endif
 
 		if (validationMode != ValidationMode::Disabled)
 		{
@@ -3086,6 +3152,11 @@ std::mutex queue_locker;
 	GraphicsDevice_DX12::~GraphicsDevice_DX12()
