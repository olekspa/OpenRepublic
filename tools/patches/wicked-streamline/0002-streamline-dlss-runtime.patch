@@ -12,6 +17,133 @@ using namespace wi::ecs;
 
 namespace wi
 {
+#if defined(OPENREPUBLIC_STREAMLINE) && defined(PLATFORM_WINDOWS_DESKTOP)
+	static bool EvaluateStreamlineDLSS(const CameraComponent& camera, const CameraComponent& previousCamera,
+		const Texture& inputColor, const Texture& depth, const Texture& motionVectors, const Texture& output, CommandList cmd, uint32_t outputWidth, uint32_t outputHeight, bool reset)
+	{
+		HMODULE module = GetModuleHandleW(L"sl.interposer.dll");
+		if (!module) return false;
+		auto getToken = reinterpret_cast<PFun_slGetNewFrameToken*>(GetProcAddress(module, "slGetNewFrameToken"));
+		auto setConstants = reinterpret_cast<PFun_slSetConstants*>(GetProcAddress(module, "slSetConstants"));
+		auto setTags = reinterpret_cast<PFun_slSetTagForFrame*>(GetProcAddress(module, "slSetTagForFrame"));
+		auto evaluate = reinterpret_cast<PFun_slEvaluateFeature*>(GetProcAddress(module, "slEvaluateFeature"));
+		auto getFeatureFunction = reinterpret_cast<PFun_slGetFeatureFunction*>(GetProcAddress(module, "slGetFeatureFunction"));
+		if (!getToken || !setConstants || !setTags || !evaluate || !getFeatureFunction) return false;
+
+		auto* device = static_cast<GraphicsDevice_DX12*>(wi::graphics::GetDevice());
+		if (!device) return false;
+		const LUID luid = device->GetNativeDevice()->GetAdapterLuid();
+		sl::AdapterInfo adapter{};
+		auto luidCopy = luid;
+		adapter.deviceLUID = reinterpret_cast<uint8_t*>(&luidCopy);
+		adapter.deviceLUIDSizeInBytes = sizeof(luidCopy);
+		auto isSupported = reinterpret_cast<PFun_slIsFeatureSupported*>(GetProcAddress(module, "slIsFeatureSupported"));
+		if (!isSupported || isSupported(sl::kFeatureDLSS, adapter) != sl::Result::eOk) return false;
+
+		PFun_slDLSSGetOptimalSettings* getOptimal = nullptr;
+		PFun_slDLSSSetOptions* setOptions = nullptr;
+		void* function = nullptr;
+		if (getFeatureFunction(sl::kFeatureDLSS, "slDLSSGetOptimalSettings", function) != sl::Result::eOk) return false;
+		getOptimal = reinterpret_cast<PFun_slDLSSGetOptimalSettings*>(function);
+		function = nullptr;
+		if (getFeatureFunction(sl::kFeatureDLSS, "slDLSSSetOptions", function) != sl::Result::eOk) return false;
+		setOptions = reinterpret_cast<PFun_slDLSSSetOptions*>(function);
+
+		const sl::ViewportHandle viewport(1);
+		sl::DLSSOptions options{};
+		options.mode = sl::DLSSMode::eBalanced;
+		options.outputWidth = outputWidth;
+		options.outputHeight = outputHeight;
+		options.colorBuffersHDR = sl::Boolean::eTrue;
+		options.useAutoExposure = sl::Boolean::eTrue;
+		sl::DLSSOptimalSettings optimal{};
+		if (getOptimal(options, optimal) != sl::Result::eOk || optimal.optimalRenderWidth != inputColor.desc.width || optimal.optimalRenderHeight != inputColor.desc.height)
+			return false; // resource recreation for a changed optimal size must happen before dispatch
+		if (setOptions(viewport, options) != sl::Result::eOk) return false;
+
+		sl::FrameToken* token = nullptr;
+		if (getToken(token, nullptr) != sl::Result::eOk || token == nullptr) return false;
+
+		auto toSLMatrix = [](const XMFLOAT4X4& src, sl::float4x4& dst)
+		{
+			const float* data = &src._11;
+			for (uint32_t row = 0; row < 4; ++row)
+				for (uint32_t col = 0; col < 4; ++col)
+					(&dst[row].x)[col] = data[row * 4 + col];
+		};
+		XMFLOAT4X4 projection = camera.Projection;
+		projection._41 -= camera.jitter.x;
+		projection._42 -= camera.jitter.y;
+		XMFLOAT4X4 previousProjection = previousCamera.Projection;
+		previousProjection._41 -= previousCamera.jitter.x;
+		previousProjection._42 -= previousCamera.jitter.y;
+		const XMMATRIX viewToClip = XMLoadFloat4x4(&projection);
+		const XMMATRIX clipToView = XMMatrixInverse(nullptr, viewToClip);
+		const XMMATRIX currentViewProjection = camera.GetView() * viewToClip;
+		const XMMATRIX previousViewProjection = previousCamera.GetView() * XMLoadFloat4x4(&previousProjection);
+		const XMMATRIX clipToPreviousClip = XMMatrixInverse(nullptr, currentViewProjection) * previousViewProjection;
+		const XMMATRIX previousClipToClip = XMMatrixInverse(nullptr, clipToPreviousClip);
+		XMFLOAT4X4 clipToViewStore{}, clipToPreviousStore{}, previousToClipStore{};
+		XMStoreFloat4x4(&clipToViewStore, clipToView);
+		XMStoreFloat4x4(&clipToPreviousStore, clipToPreviousClip);
+		XMStoreFloat4x4(&previousToClipStore, previousClipToClip);
+		sl::Constants constants{};
+		toSLMatrix(projection, constants.cameraViewToClip);
+		toSLMatrix(clipToViewStore, constants.clipToCameraView);
+		toSLMatrix(clipToPreviousStore, constants.clipToPrevClip);
+		toSLMatrix(previousToClipStore, constants.prevClipToClip);
+		constants.jitterOffset = { camera.jitter.x * inputColor.desc.width * 0.5f, camera.jitter.y * inputColor.desc.height * -0.5f };
+		constants.mvecScale = { 1.0f, 1.0f };
+		constants.cameraPos = { camera.Eye.x, camera.Eye.y, camera.Eye.z };
+		constants.cameraUp = { camera.Up.x, camera.Up.y, camera.Up.z };
+		const XMVECTOR rightVector = camera.GetRight();
+		XMFLOAT3 right{};
+		XMStoreFloat3(&right, rightVector);
+		constants.cameraRight = { right.x, right.y, right.z };
+		XMFLOAT3 forward{};
+		XMStoreFloat3(&forward, XMVector3Normalize(camera.GetAt() - camera.GetEye()));
+		constants.cameraFwd = { forward.x, forward.y, forward.z };
+		constants.cameraNear = camera.zNearP;
+		constants.cameraFar = camera.zFarP;
+		constants.cameraFOV = camera.fov;
+		constants.cameraAspectRatio = camera.width / camera.height;
+		constants.depthInverted = sl::Boolean::eTrue;
+		constants.cameraMotionIncluded = sl::Boolean::eTrue;
+		constants.motionVectors3D = sl::Boolean::eFalse;
+		constants.motionVectorsJittered = sl::Boolean::eTrue;
+		constants.reset = reset ? sl::Boolean::eTrue : sl::Boolean::eFalse;
+		if (setConstants(constants, *token, viewport) != sl::Result::eOk) return false;
+
+		auto makeResource = [device](const Texture& texture)
+		{
+			ID3D12Resource* nativeResource = device->GetTextureInternalResource(&texture);
+			sl::Resource result(sl::ResourceType::eTex2d, nativeResource,
+				static_cast<uint32_t>(device->GetTextureInternalResourceState(&texture)));
+			result.width = texture.desc.width;
+			result.height = texture.desc.height;
+			result.nativeFormat = static_cast<uint32_t>(nativeResource->GetDesc().Format);
+			return result;
+		};
+		sl::Resource colorResource = makeResource(inputColor);
+		sl::Resource depthResource = makeResource(depth);
+		sl::Resource motionResource = makeResource(motionVectors);
+		sl::Resource outputResource = makeResource(output);
+		sl::Extent renderExtent{ 0, 0, inputColor.desc.width, inputColor.desc.height };
+		sl::Extent outputExtent{ 0, 0, output.desc.width, output.desc.height };
+		sl::ResourceTag tags[] = {
+			{ &colorResource, sl::kBufferTypeScalingInputColor, sl::ResourceLifecycle::eValidUntilEvaluate, &renderExtent },
+			{ &depthResource, sl::kBufferTypeDepth, sl::ResourceLifecycle::eValidUntilEvaluate, &renderExtent },
+			{ &motionResource, sl::kBufferTypeMotionVectors, sl::ResourceLifecycle::eValidUntilEvaluate, &renderExtent },
+			{ &outputResource, sl::kBufferTypeScalingOutputColor, sl::ResourceLifecycle::eValidUntilEvaluate, &outputExtent },
+		};
+		ID3D12GraphicsCommandList* nativeCommandList = device->GetNativeGraphicsCommandList(cmd);
+		auto* commandBuffer = reinterpret_cast<sl::CommandBuffer*>(nativeCommandList);
+		if (setTags(*token, viewport, tags, static_cast<uint32_t>(std::size(tags)), commandBuffer) != sl::Result::eOk) return false;
+		const sl::BaseStructure* inputs[] = { &viewport };
+		if (evaluate(sl::kFeatureDLSS, *token, inputs, 1, commandBuffer) != sl::Result::eOk) return false;
+		return true;
+	}
+#endif
 	static constexpr float foreground_depth_range = 0.01f;
 
 	void RenderPath3D::DeleteGPUResources()
@@ -330,6 +462,7 @@ namespace wi
 		setRaytracedDiffuseEnabled(raytracedDiffuseEnabled);
 		setFSREnabled(fsrEnabled);
 		setFSR2Enabled(fsr2Enabled);
+		setDLSSEnabled(dlssEnabled);
 		setEyeAdaptionEnabled(eyeAdaptionEnabled);
 		setReflectionsEnabled(reflectionsEnabled);
 		setBloomEnabled(bloomEnabled);
@@ -423,7 +556,7 @@ namespace wi
 		{
 			camera->jitter = fsr2Resources.GetJitter();
 		}
-		else if (wi::renderer::GetTemporalAAEnabled() && wi::renderer::GetWireframeMode() == wi::renderer::WIREFRAME_DISABLED)
+		else if ((wi::renderer::GetTemporalAAEnabled() || getDLSSEnabled()) && wi::renderer::GetWireframeMode() == wi::renderer::WIREFRAME_DISABLED)
 		{
 			const XMFLOAT4& halton = wi::math::GetHaltonSequence(wi::graphics::GetDevice()->GetFrameCount() % 256);
 			camera->jitter.x = (halton.x * 2 - 1) / (float)internalResolution.x;
@@ -2347,6 +2480,17 @@ namespace wi
 
 		// 1.) HDR post process chain
 		{
+#if defined(OPENREPUBLIC_STREAMLINE) && defined(PLATFORM_WINDOWS_DESKTOP)
+			if (getDLSSEnabled() && rtFSR[0].IsValid() && EvaluateStreamlineDLSS(*camera, camera_previous, *rt_read, depthBuffer_Copy, rtVelocity, rtFSR[0], cmd, GetPhysicalWidth(), GetPhysicalHeight(), first_frame))
+			{
+				// Streamline may change command-list state; restore Wicked's bindings before later passes.
+				wi::renderer::BindCameraCB(*camera, camera_previous, camera_reflection, cmd);
+				wi::renderer::BindCommonResources(cmd);
+				rt_read = &rtFSR[0];
+				rt_write = &rtFSR[1];
+			}
+			else
+#endif
 			if (getFSR2Enabled() && fsr2Resources.IsValid())
 			{
 				wi::renderer::Postprocess_FSR2(
@@ -3001,6 +3145,7 @@ namespace wi
 	void RenderPath3D::setFSR2Enabled(bool value)
 	{
 		fsr2Enabled = value;
+		if (value) dlssEnabled = false;
 
 		if (fsr2Enabled)
 		{
@@ -3040,6 +3185,63 @@ namespace wi
 		motionblurResources = {};
 		depthoffieldResources = {};
 	}
+	void RenderPath3D::setDLSSEnabled(bool value)
+	{
+#if defined(OPENREPUBLIC_STREAMLINE) && defined(PLATFORM_WINDOWS_DESKTOP)
+		if (!value)
+		{
+			dlssEnabled = false;
+			if (!getFSREnabled()) { rtFSR[0] = {}; rtFSR[1] = {}; }
+			return;
+		}
+		HMODULE module = GetModuleHandleW(L"sl.interposer.dll");
+		auto getFeatureFunction = module ? reinterpret_cast<PFun_slGetFeatureFunction*>(GetProcAddress(module, "slGetFeatureFunction")) : nullptr;
+		if (!getFeatureFunction) { dlssEnabled = false; return; }
+		void* function = nullptr;
+		if (getFeatureFunction(sl::kFeatureDLSS, "slDLSSGetOptimalSettings", function) != sl::Result::eOk || !function) { dlssEnabled = false; return; }
+		auto getOptimal = reinterpret_cast<PFun_slDLSSGetOptimalSettings*>(function);
+		sl::DLSSOptions options{};
+		options.mode = sl::DLSSMode::eBalanced;
+		options.outputWidth = GetPhysicalWidth();
+		options.outputHeight = GetPhysicalHeight();
+		options.colorBuffersHDR = sl::Boolean::eTrue;
+		options.useAutoExposure = sl::Boolean::eTrue;
+		sl::DLSSOptimalSettings optimal{};
+		if (GetPhysicalWidth() == 0 || GetPhysicalHeight() == 0 || getOptimal(options, optimal) != sl::Result::eOk || optimal.optimalRenderWidth == 0 || optimal.optimalRenderHeight == 0)
+		{
+			dlssEnabled = false;
+			return;
+		}
+		const float targetScale = std::min(float(optimal.optimalRenderWidth) / float(GetPhysicalWidth()), float(optimal.optimalRenderHeight) / float(GetPhysicalHeight()));
+		fsr2Enabled = false;
+		fsr2Resources = {};
+		dlssEnabled = true;
+		if (std::abs(resolutionScale - targetScale) > 0.001f)
+		{
+			resolutionScale = targetScale;
+			ResizeBuffers();
+			return;
+		}
+		if (rtFSR[0].IsValid() && rtFSR[0].desc.width == GetPhysicalWidth() && rtFSR[0].desc.height == GetPhysicalHeight())
+			return;
+		GraphicsDevice* device = wi::graphics::GetDevice();
+		TextureDesc desc;
+		desc.bind_flags = BindFlag::SHADER_RESOURCE | BindFlag::UNORDERED_ACCESS;
+		desc.format = wi::renderer::format_rendertarget_main;
+		desc.width = GetPhysicalWidth();
+		desc.height = GetPhysicalHeight();
+		device->CreateTexture(&desc, nullptr, &rtFSR[0]);
+		device->CreateTexture(&desc, nullptr, &rtFSR[1]);
+		device->SetName(&rtFSR[0], "renderpath3D.rtDLSS[0]");
+		device->SetName(&rtFSR[1], "renderpath3D.rtDLSS[1]");
+		motionblurResources = {};
+		depthoffieldResources = {};
+#else
+		dlssEnabled = false;
+		(void)value;
+#endif
+	}
+
 	void RenderPath3D::setFSR2Preset(FSR2_Preset preset)
 	{
 		wi::graphics::SamplerDesc desc = wi::renderer::GetSampler(wi::enums::SAMPLER_OBJECTSHADER)->GetDesc();
