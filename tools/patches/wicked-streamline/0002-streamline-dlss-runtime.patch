 	static PFN_DXGI_GET_DEBUG_INTERFACE1 DXGIGetDebugInterface1 = nullptr;
 #endif
 	static PFN_D3D12_CREATE_DEVICE D3D12CreateDevice = nullptr;
+#ifdef OPENREPUBLIC_STREAMLINE
+	static HMODULE streamline_module = nullptr;
+	static sl::Result (*streamline_init)(const sl::Preferences&, uint64_t) = nullptr;
+	static sl::Result (*streamline_shutdown)() = nullptr;
+	static sl::Result (*streamline_set_device)(void*) = nullptr;
+	static bool streamline_initialized = false;
+
+	static void InitializeStreamline()
+	{
+		wchar_t executable[MAX_PATH]{};
+		GetModuleFileNameW(nullptr, executable, MAX_PATH);
+		std::wstring folder(executable);
+		folder = folder.substr(0, folder.find_last_of(L"\\/"));
+		const std::wstring interposer_path = folder + L"\\sl.interposer.dll";
+		streamline_module = LoadLibraryExW(interposer_path.c_str(), nullptr, LOAD_LIBRARY_SEARCH_DLL_LOAD_DIR | LOAD_LIBRARY_SEARCH_DEFAULT_DIRS);
+		if (!streamline_module)
+		{
+			wi::helper::DebugOut("Streamline disabled: sl.interposer.dll not found next to executable\n");
+			return;
+		}
+		streamline_init = reinterpret_cast<decltype(streamline_init)>(GetProcAddress(streamline_module, "slInit"));
+		streamline_shutdown = reinterpret_cast<decltype(streamline_shutdown)>(GetProcAddress(streamline_module, "slShutdown"));
+		streamline_set_device = reinterpret_cast<decltype(streamline_set_device)>(GetProcAddress(streamline_module, "slSetD3DDevice"));
+		if (!streamline_init || !streamline_shutdown || !streamline_set_device)
+		{
+			wi::helper::DebugOut("Streamline disabled: required exports missing\n");
+			FreeLibrary(streamline_module);
+			streamline_module = nullptr;
+			return;
+		}
+		const sl::Feature features[] = { sl::kFeatureDLSS };
+		const std::wstring plugin_folder = folder + L"\\plugins";
+		const wchar_t* paths[] = { plugin_folder.c_str(), folder.c_str() };
+		sl::Preferences preferences{};
+		preferences.pathsToPlugins = paths;
+		preferences.numPathsToPlugins = 2;
+		preferences.featuresToLoad = features;
+		preferences.numFeaturesToLoad = 1;
+		preferences.flags = sl::PreferenceFlags::eUseFrameBasedResourceTagging;
+		preferences.renderAPI = sl::RenderAPI::eD3D12;
+		preferences.logLevel = sl::LogLevel::eDefault;
+		const sl::Result result = streamline_init(preferences, sl::kSDKVersion);
+		streamline_initialized = result == sl::Result::eOk;
+		wi::helper::DebugOut(streamline_initialized ? "Streamline initialized\n" : "Streamline initialization failed\n");
+		if (!streamline_initialized)
+		{
+			FreeLibrary(streamline_module);
+			streamline_module = nullptr;
+		}
+	}
+#endif
 	static PFN_D3D12_CREATE_VERSIONED_ROOT_SIGNATURE_DESERIALIZER D3D12CreateVersionedRootSignatureDeserializer = nullptr;
 	static PFN_D3D12_SERIALIZE_ROOT_SIGNATURE D3D12SerializeRootSignature = nullptr;
 #endif // PLATFORM_WINDOWS_DESKTOP
@@ -2239,6 +2293,9 @@ std::mutex queue_locker;
 		validationMode = validationMode_;
 
 #ifdef PLATFORM_WINDOWS_DESKTOP
+		#ifdef OPENREPUBLIC_STREAMLINE
+		InitializeStreamline();
+#endif
 		HMODULE dxgi = LoadLibraryEx(L"dxgi.dll", nullptr, LOAD_LIBRARY_SEARCH_SYSTEM32);
